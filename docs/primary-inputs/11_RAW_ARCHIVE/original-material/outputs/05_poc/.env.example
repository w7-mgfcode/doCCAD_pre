# ---------------------------------------------------------------------------
# Provider credentials and model selection for the AI generation plane.
# Copy to .env (git-ignored) or set as GitHub Actions secrets/variables.
# NEVER commit real values. The site build and all validation scripts work
# with none of these set; only live generation needs them.
# ---------------------------------------------------------------------------

# --- API keys (secrets) -----------------------------------------------------
ANTHROPIC_API_KEY=            # https://console.anthropic.com/ — Messages API key
GEMINI_API_KEY=               # Google AI Studio API key
OPENAI_API_KEY=               # OpenAI platform API key
LOCAL_API_KEY=                # optional bearer token for a local vLLM endpoint

# --- Model identifiers (config, not secrets) --------------------------------
# Referenced from ai.config.yaml as ${AI_MODEL_*}. Keeping model ids here means
# provider model churn never requires a code or config-file change (AD-5).
AI_MODEL_ANTHROPIC=           # e.g. an Anthropic Messages API model id
AI_MODEL_GEMINI=              # e.g. a Gemini generateContent model id
AI_MODEL_OPENAI=              # e.g. an OpenAI chat-completions model id
AI_MODEL_LOCAL=               # e.g. the model name served by Ollama/vLLM
