{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "Documentation frontmatter contract (AD-8, extended for DOCCAD prototype)",
  "type": "object",
  "required": ["id", "title", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Stable, globally unique, path-derived slug; never recycled."
    },
    "slug": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["canonical", "generated", "stub"]},
    "stub_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the hold stub contract."
    },
    "hold_reason": {
      "type": "string",
      "description": "Reason the view is held from publication."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"],
      "default": "private",
      "description": "Content classification (T12). Default private when omitted."
    },
    "privacy": {
      "type": "string",
      "enum": ["public", "private"],
      "description": "Synonym for visibility (AD-12)."
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["developer", "architect", "operator", "user", "recruiter", "interviewer", "reviewer"]
      }
    },
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Repo paths this page documents; drift inputs for detect_changes."
    },
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related": {"type": "array", "items": {"type": "string"}},
    "ai_generation": {
      "type": "object",
      "required": ["allowed"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "boolean"},
        "derived_pages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "last_validated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated": {"type": "boolean"},
    "generation": {"$ref": "#/$defs/generation"},
    "provenance_history": {"$ref": "#/$defs/generation"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "canonical"}}, "required": ["type"]},
      "then": {
        "required": ["audience", "owners", "last_validated"],
        "not": {
          "anyOf": [
            {"required": ["generation"]},
            {"properties": {"generated": {"const": true}}, "required": ["generated"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "generated"}}, "required": ["type"]},
      "then": {
        "required": ["generated", "generation", "audience", "owners"],
        "properties": {"generated": {"const": true}}
      }
    },
    {
      "if": {"properties": {"type": {"const": "stub"}}, "required": ["type"]},
      "then": {
        "required": ["stub_version", "audience", "owners", "hold_reason"],
        "not": {
          "required": ["generation"]
        }
      }
    }
  ],
  "$defs": {
    "generation": {
      "type": "object",
      "required": [
        "contract",
        "contract_version",
        "prompt_version",
        "source_documents",
        "provider",
        "model",
        "generated_at",
        "approval_status"
      ],
      "properties": {
        "contract": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "contract_version": {"type": "integer", "minimum": 1},
        "prompt_version": {"type": "string", "pattern": "^[a-z0-9-]+\\.v\\d+$"},
        "source_documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path", "content_hash"],
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"},
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "repo_evidence": {"type": "array", "items": {"type": "string"}},
        "provider": {"enum": ["anthropic", "gemini", "openai", "local", "fixture"]},
        "model": {"type": "string", "minLength": 1},
        "generation_mode": {"enum": ["production", "demo"]},
        "generated_at": {"type": "string"},
        "approval_status": {"enum": ["draft", "in-review", "approved", "approved-for-demo", "rejected"]}
      }
    }
  }
}
