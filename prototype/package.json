{
  "name": "doccad-prototype",
  "version": "0.2.0",
  "private": true,
  "description": "DOCCAD Prototype: GitHub-native, AI-augmented documentation ecosystem with deterministic workflows and governance",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "build:demo": "python3 scripts/build_filter.py --mode demo && docusaurus build",
    "build:production": "python3 scripts/build_filter.py --mode production && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "validate": "python3 scripts/validate_docs.py",
    "detect": "python3 scripts/detect_changes.py --all",
    "test": "python3 -m unittest discover tests -v"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/plugin-content-pages": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=24.14"
  }
}
